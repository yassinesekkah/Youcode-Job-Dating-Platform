{% extends "layouts/back.twig" %}

{% block content %}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-semibold text-gray-800">
        Job Announcements
    </h1>

    <a href="/admin/announcements/create"
        class="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition">
        + Create Announcement
    </a>
</div>
<div class="mb-6">
    <input
        type="text"
        id="searchInput"
        placeholder="Search an annonce..."
        class="w-full max-w-md border rounded-lg px-4 py-2"
    >
</div>

<div id="announcementList">
    {% include "back/announcements/_announcements.twig" with {
        announcements: announcements,
        csrf_token: csrf_token
    } %}
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const searchInput = document.getElementById('searchInput');
    const list = document.getElementById('announcementList');

    let timeout = null;

    searchInput.addEventListener('input', function () {

        clearTimeout(timeout);

        timeout = setTimeout(() => {
            const query = searchInput.value;

            fetch('/admin/announcements/ajax?q=' + encodeURIComponent(query))
                .then(res => res.text())
                .then(html => list.innerHTML = html)
                .catch(err => console.error(err));
        }, 300); 
    });

});
</script>

{% endblock %}