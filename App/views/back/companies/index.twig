{% extends "layouts/back.twig" %}

{% block content %}

<div class="flex justify-between items-center mb-8">
    <h1 class="text-2xl font-semibold text-gray-800">
        Companies
    </h1>

    <a href="/admin/companies/create"
       class="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm font-medium
              hover:bg-indigo-700 transition">
        + Add Company
    </a>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

    {% for company in companies %}
    <div class="bg-white rounded-xl shadow hover:shadow-lg transition p-6 flex flex-col">

        <!-- Header -->
        <div class="flex items-center gap-4 mb-4">
            <img src="{{ company.avatar }}"
                 alt="avatar"
                 class="w-14 h-14 rounded-full object-cover border">

            <div>
                <h2 class="text-lg font-semibold text-gray-800">
                    {{ company.name }}
                </h2>
                <p class="text-sm text-gray-500">
                    {{ company.sector }}
                </p>
            </div>
        </div>

        <!-- Infos -->
        <div class="text-sm text-gray-600 space-y-1 flex-1">
            <p class="flex items-center gap-2">
                <span>📍</span>
                <span>{{ company.location }}</span>
            </p>

            <p class="flex items-center gap-2">
                <span>📧</span>
                <span class="truncate">{{ company.email }}</span>
            </p>

            <p class="flex items-center gap-2">
                <span>📞</span>
                <span>{{ company.phone }}</span>
            </p>
        </div>

        <!-- Actions -->
        <div class="flex justify-end gap-4 mt-6 text-sm font-medium">
            <a href="/admin/companies/edit?id={{ company.id }}"
               class="text-indigo-600 hover:underline">
                Edit
            </a>

            <a href="/admin/companies/delete?id={{ company.id }}&csrf_token={{ csrf_token }}"
               class="text-red-600 hover:underline"
               onclick="return confirm('Are you sure you want to delete this company?')">
                Delete
            </a>
        </div>

    </div>
    {% else %}
        <p class="text-gray-500">
            No companies found.
        </p>
    {% endfor %}

</div>

{% endblock %}
