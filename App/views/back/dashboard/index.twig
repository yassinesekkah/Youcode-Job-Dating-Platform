{% extends "layouts/back.twig" %}

{% block content %}

<!-- Page Title -->
<div class="mb-8">
    <h1 class="text-2xl font-semibold text-gray-800">
        Admin Dashboard
    </h1>
    <p class="text-sm text-gray-500 mt-1">
        Overview of platform activity
    </p>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">

    <!-- Active Announcements -->
    <div class="bg-gradient-to-br from-indigo-500 to-indigo-600
                text-white rounded-xl shadow p-6">
        <p class="text-sm opacity-80">Active Announcements</p>
        <p class="text-4xl font-bold mt-2">
            {{ activeAnnouncements }}
        </p>
        <p class="text-xs opacity-80 mt-4">
            Currently visible offers
        </p>
    </div>

    <!-- Archived Announcements -->
    <div class="bg-gradient-to-br from-slate-500 to-slate-600
                text-white rounded-xl shadow p-6">
        <p class="text-sm opacity-80">Archived Announcements</p>
        <p class="text-4xl font-bold mt-2">
            {{ archivedAnnouncements }}
        </p>
        <p class="text-xs opacity-80 mt-4">
            Hidden job offers
        </p>
    </div>

    <!-- Companies -->
    <div class="bg-gradient-to-br from-teal-500 to-teal-600
                text-white rounded-xl shadow p-6">
        <p class="text-sm opacity-80">Companies</p>
        <p class="text-4xl font-bold mt-2">
            {{ companiesCount }}
        </p>
        <p class="text-xs opacity-80 mt-4">
            Registered partners
        </p>
    </div>

    <!-- Students -->
    <div class="bg-gradient-to-br from-sky-500 to-sky-600
                text-white rounded-xl shadow p-6">
        <p class="text-sm opacity-80">Students</p>
        <p class="text-4xl font-bold mt-2">
            {{ studentsCount }}
        </p>
        <p class="text-xs opacity-80 mt-4">
            Active learners
        </p>
    </div>

</div>

<!-- Recent Announcements -->
<div class="mt-10 bg-white rounded-xl shadow p-6">

    <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold text-gray-800">
            Recent Job Announcements
        </h2>

        <a href="/admin/announcements"
           class="text-sm text-indigo-600 hover:underline">
            View all
        </a>
    </div>

    {% if recentAnnouncements is empty %}
        <p class="text-sm text-gray-500">
            No recent announcements.
        </p>
    {% else %}
        <ul class="divide-y">
            {% for announcement in recentAnnouncements %}
                <li class="py-3 flex justify-between items-center">
                    <div>
                        <p class="text-sm font-medium text-gray-800">
                            {{ announcement.title }}
                        </p>
                        <p class="text-xs text-gray-500">
                            {{ announcement.company }}
                        </p>
                    </div>

                    <span class="text-xs text-gray-400">
                        {{ announcement.created_at|date("d M Y") }}
                    </span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

</div>

{% endblock %}
