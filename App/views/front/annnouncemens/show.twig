{% extends 'front/layout.twig' %}

{% block title %}{{ announcement.title }}{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto bg-white p-6 rounded-lg shadow">

    <h1 class="text-2xl font-bold mb-4">{{ announcement.title }}</h1>

    <form class="space-y-4">

        <div>
            <label class="block font-semibold">Entreprise</label>
            <input type="text" value="{{ announcement.company }}" disabled
                   class="w-full border p-2 rounded bg-gray-100">
        </div>

        <div>
            <label class="block font-semibold">Type de contrat</label>
            <input type="text" value="{{ announcement.contract_type }}" disabled
                   class="w-full border p-2 rounded bg-gray-100">
        </div>

        <div>
            <label class="block font-semibold">Localisation</label>
            <input type="text" value="{{ announcement.location }}" disabled
                   class="w-full border p-2 rounded bg-gray-100">
        </div>

        <div>
            <label class="block font-semibold">Description</label>
            <textarea disabled
                      class="w-full border p-2 rounded bg-gray-100"
                      rows="5">{{ announcement.description }}</textarea>
        </div>

        <div class="text-right">
            <a href="/" class="text-blue-600 hover:underline">← Retour</a>
        </div>

    </form>
</div>
{% endblock %}
