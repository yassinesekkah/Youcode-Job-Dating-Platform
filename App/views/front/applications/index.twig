{% extends "layouts/front.twig" %}

{% block title %}Mes candidatures{% endblock %}

{% block content %}

<!-- Page header -->
<div class="mb-10">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Mes candidatures
    </h1>
    <p class="text-gray-500">
        Suivez l’état de vos candidatures en temps réel.
    </p>
</div>

{% if applications|length > 0 %}

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    {% for app in applications %}
        <div class="bg-white rounded-xl shadow hover:shadow-lg transition p-6">

            <!-- Offer title -->
            <h3 class="text-lg font-semibold text-gray-800 mb-1">
                {{ app.announcement_title }}
            </h3>

            <!-- Company -->
            <p class="text-sm text-gray-500 mb-4">
                {{ app.company_name }}
            </p>

            <!-- Infos -->
            <div class="flex justify-between items-center">

                <!-- Date -->
                <span class="text-xs text-gray-400">
                    Postulé le {{ app.created_at|date("d/m/Y") }}
                </span>

                <!-- Status -->
                {% if app.status == 'pending' %}
                    <span class="px-3 py-1 rounded-full text-xs font-medium
                                 bg-yellow-100 text-yellow-700">
                        En attente
                    </span>
                {% elseif app.status == 'accepted' %}
                    <span class="px-3 py-1 rounded-full text-xs font-medium
                                 bg-green-100 text-green-700">
                        Acceptée
                    </span>
                {% else %}
                    <span class="px-3 py-1 rounded-full text-xs font-medium
                                 bg-red-100 text-red-700">
                        Refusée
                    </span>
                {% endif %}
            </div>

        </div>
    {% endfor %}

</div>

{% else %}

<!-- Empty state -->
<div class="bg-white rounded-xl shadow p-12 text-center">

    <div class="text-5xl mb-4">📄</div>

    <h2 class="text-xl font-semibold text-gray-800 mb-2">
        Aucune candidature
    </h2>

    <p class="text-gray-500 mb-6">
        Vous n'avez pas encore postulé à une offre.
    </p>

    <a href="/"
       class="inline-block bg-indigo-600 text-white px-6 py-3 rounded-lg
              hover:bg-indigo-700 transition">
        Voir les offres
    </a>

</div>

{% endif %}

{% endblock %}
