{% for announcement in announcements %}
<div class="group bg-white rounded-xl border shadow hover:shadow-xl transition transform hover:-translate-y-1 overflow-hidden">

    <div class="relative">
        {% if announcement.image %}
            <img src="{{ announcement.image|e }}" class="h-44 w-full object-cover">
        {% else %}
            <div class="h-44 bg-gradient-to-r from-gray-200 to-gray-300 flex items-center justify-center text-gray-500">
                No image
            </div>
        {% endif %}

        <span class="absolute top-3 left-3 bg-blue-600 text-white text-xs px-3 py-1 rounded-full">
            {{ announcement.contract_type }}
        </span>
    </div>

    <div class="p-5">
        <h3 class="text-lg font-semibold text-gray-800 mb-1">
            {{ announcement.title|e }}
        </h3>

        <p class="text-sm text-gray-600 mb-2">
            {{ announcement.company|e }} • {{ announcement.location|e }}
        </p>

        <p class="text-xs text-gray-400 mb-4">
            Publié le {{ announcement.created_at|date("d/m/Y") }}
        </p>

        <a href="/show?id={{ announcement.id }}"
           class="inline-block w-full text-center bg-blue-600 text-white py-2 rounded-lg text-sm font-medium
                  hover:bg-blue-700 transition">
            Voir l'offre
        </a>
    </div>
</div>
{% else %}
<p class="col-span-full text-center text-gray-500">
    Aucune annonce trouvée.
</p>
{% endfor %}
