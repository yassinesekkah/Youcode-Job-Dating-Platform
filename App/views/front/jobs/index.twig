{% extends "layouts/front.twig" %}

{% block title %}Offres d'emploi{% endblock %}

{% block content %}
<div class="mb-10">
    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl p-8 text-white">
        <h1 class="text-4xl font-bold mb-2">
            Trouvez votre prochaine opportunité
        </h1>
        <p class="text-blue-100 text-lg">
            Des offres sélectionnées pour les apprenants YouCode
        </p>
    </div>
</div>


<div class="bg-white p-5 rounded-xl shadow mb-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <input type="text" id="searchInput" placeholder="🔍 Rechercher une offre..."
            class="border border-gray-300 rounded-full px-5 py-3 focus:ring-2 focus:ring-blue-500 outline-none">

        <select id="companyFilter"
            class="border border-gray-300 rounded-full px-5 py-3 focus:ring-2 focus:ring-blue-500 outline-none">
            <option value="">🏢 Toutes les entreprises</option>
            {% set companies = [] %}
            {% for announcement in announcements %}
            {% if announcement.company not in companies %}
            {% set companies = companies|merge([announcement.company]) %}
            <option value="{{ announcement.company }}">{{ announcement.company }}</option>
            {% endif %}
            {% endfor %}
        </select>

        <select id="contractFilter"
            class="border border-gray-300 rounded-full px-5 py-3 focus:ring-2 focus:ring-blue-500 outline-none">
            <option value="">📄 Tous les contrats</option>
            {% set contracts = [] %}
            {% for announcement in announcements %}
            {% if announcement.contract_type not in contracts %}
            {% set contracts = contracts|merge([announcement.contract_type]) %}
            <option value="{{ announcement.contract_type }}">{{ announcement.contract_type }}</option>
            {% endif %}
            {% endfor %}
        </select>
    </div>
</div>


<div id="jobList" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
    {% include "front/jobs/_cards.twig" with { announcements: announcements } %}
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById('searchInput');
        const companyFilter = document.getElementById('companyFilter');
        const contractFilter = document.getElementById('contractFilter');
        const jobList = document.getElementById('jobList');

        function fetchFilteredJobs() {
            const q = searchInput.value;
            const company = companyFilter.value;
            const contract = contractFilter.value;

            const params = new URLSearchParams({ q, company, contract });

            fetch('/jobs/ajax?' + params.toString())
                .then(res => res.text())
                .then(html => jobList.innerHTML = html)
                .catch(err => console.error(err));
        }

        searchInput.addEventListener('input', fetchFilteredJobs);
        companyFilter.addEventListener('change', fetchFilteredJobs);
        contractFilter.addEventListener('change', fetchFilteredJobs);
    });
</script>

{% endblock %}