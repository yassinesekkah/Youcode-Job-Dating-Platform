{% extends "layouts/front.twig" %}

{% block title %}{{ announcement.title }}{% endblock %}

{% block content %}

<div class="max-w-5xl mx-auto">
{# Flash messages #}
{% if flash.success %}
    <div class="mb-6 rounded-xl bg-green-50 border border-green-200 p-4">
        <p class="text-green-700 font-medium">
            {{ flash.success }}
        </p>
    </div>
{% endif %}

{% if flash.error %}
    <div class="mb-6 rounded-xl bg-red-50 border border-red-200 p-4">
        <p class="text-red-700 font-medium">
            {{ flash.error }}
        </p>
    </div>
{% endif %}
    <!-- Header -->
    <div class="mb-10">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl p-8 text-white">
            <span class="inline-block bg-white/20 px-4 py-1 rounded-full text-sm mb-4">
                {{ announcement.contract_type }}
            </span>

            <h1 class="text-4xl font-bold mb-2">
                {{ announcement.title }}
            </h1>

            <p class="text-blue-100 text-lg">
                {{ announcement.company }} • {{ announcement.location }}
            </p>
        </div>
    </div>

    <!-- Content Card -->
    <div class="bg-white rounded-xl shadow-lg overflow-hidden">

        {% if announcement.image %}
        <img src="{{ announcement.image|e }}" alt="{{ announcement.title|e }}" class="w-full h-72 object-cover">
        {% endif %}

        <div class="p-8 space-y-8">

            <!-- Infos -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-gray-50 rounded-lg p-4">
                    <p class="text-xs text-gray-500 mb-1">Entreprise</p>
                    <p class="font-semibold text-gray-800">
                        {{ announcement.company }}
                    </p>
                </div>

                <div class="bg-gray-50 rounded-lg p-4">
                    <p class="text-xs text-gray-500 mb-1">Type de contrat</p>
                    <p class="font-semibold text-gray-800">
                        {{ announcement.contract_type }}
                    </p>
                </div>

                <div class="bg-gray-50 rounded-lg p-4">
                    <p class="text-xs text-gray-500 mb-1">Localisation</p>
                    <p class="font-semibold text-gray-800">
                        {{ announcement.location }}
                    </p>
                </div>
            </div>

            <!-- Description -->
            <div>
                <h2 class="text-xl font-semibold text-gray-800 mb-3">
                    Description du poste
                </h2>
                <p class="text-gray-700 leading-relaxed whitespace-pre-line">
                    {{ announcement.description }}
                </p>
            </div>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 pt-6 border-t">

                <a href="/" class="text-blue-600 hover:underline text-sm">
                    ← Retour aux offres
                </a>

                <a href="/applications/create?announcement_id={{ announcement.id }}" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg font-medium
          hover:bg-blue-700 transition">
                    Postuler
                </a>

            </div>
        </div>
    </div>

</div>

{% endblock %}