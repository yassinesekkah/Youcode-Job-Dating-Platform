<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title|default('Admin • Job Dating') }}</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/assets/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/assets/favicon.png">


</head>

<body class="bg-gray-100 min-h-screen">

    <!-- Wrapper -->
    <div class="flex min-h-screen">

        <!-- Sidebar -->
        <aside class="fixed left-0 top-0 w-64 h-screen bg-slate-900 text-slate-100 flex flex-col">
            <div class="px-16 py-5 border-b border-slate-800 flex items-center gap-2">

                <!-- Logo Icon -->
                <div class="w-9 h-9 rounded-lg bg-indigo-600
                flex items-center justify-center text-white font-bold">
                    JL
                </div>

                <!-- Logo Text -->
                <div>
                    <h1 class="text-lg font-semibold tracking-wide leading-tight">
                        Job<span class="text-indigo-400">Link</span>
                    </h1>
                    <span class="block text-xs text-slate-400">
                        Admin Panel
                    </span>
                </div>

            </div>

            <nav class="flex-1 px-4 py-6 space-y-2">
                <a href="/admin/dashboard"
                    class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 transition">
                    <span>📊</span> Dashboard
                </a>

                <a href="/admin/announcements"
                    class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 transition">
                    <span>📄</span> Announcements
                </a>

                <a href="/admin/announcements/archived"
                    class="flex items-center gap-3 px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800 transition">
                    <span>🗄️</span> Archived Announcements
                </a>

                <a href="/admin/companies"
                    class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 transition">
                    <span>🏢</span> Companies
                </a>

                <a href="/admin/students"
                    class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-800 transition">
                    <span>🎓</span> Students
                </a>
            </nav>

            <div class="px-4 py-4 border-t border-slate-800">
                <a href="/admin/logout"
                    class="block text-center px-3 py-2 rounded-lg text-red-400 hover:bg-slate-800 transition">
                    Logout
                </a>
            </div>
        </aside>

        <!-- Main Area -->
        <div class="ml-64 flex-1 flex flex-col">

            <!-- Top Navbar -->
            <header class="fixed top-0 left-64 right-0 bg-white shadow-sm z-10">
                <div class="px-8 py-4 flex justify-between items-center">
                    <h2 class="text-lg font-semibold text-gray-800">
                        {{ page_title|default('Dashboard') }}
                    </h2>

                    <div class="flex items-center gap-4">
                        <span class="text-sm text-gray-600">
                            Admin
                        </span>
                        <div
                            class="w-9 h-9 rounded-full bg-indigo-600 text-white flex items-center justify-center font-semibold">
                            A
                        </div>
                    </div>
                </div>
            </header>

            <!-- Content -->
            <main class="flex-1 p-8 pt-24 overflow-y-auto">
                {% if flash.success %}
                <div id="toast" class="fixed bottom-6 left-6 z-50
            bg-green-600 text-white
            px-4 py-3 rounded-lg shadow-lg
            text-sm font-medium
            transform translate-y-10 opacity-0
            transition-all duration-500">
                    {{ flash.success }}
                </div>
                {% endif %}

                {% if flash.error %}
                <div id="toast" class="fixed bottom-6 left-6 z-50
            bg-red-600 text-white
            px-4 py-3 rounded-lg shadow-lg
            text-sm font-medium
            transform translate-y-10 opacity-0
            transition-all duration-500">
                    {{ flash.error }}
                </div>
                {% endif %}


                {% block content %}{% endblock %}
            </main>
        </div>
    </div>

    <script>
        const toast = document.getElementById('toast');

        if (toast) {

            setTimeout(() => {
                toast.classList.remove('translate-y-10', 'opacity-0');
            }, 100);


            setTimeout(() => {
                toast.classList.add('translate-y-10', 'opacity-0');
                setTimeout(() => toast.remove(), 500);
            }, 3000);
        }
    </script>
</body>

</html>