<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title|default('Job Dating • Front Office') }}</title>



    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 min-h-screen flex flex-col">

<!-- Navbar -->
<header class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">

    
        <a href="/" class="text-2xl font-bold text-blue-600">
            Job<span class="text-gray-900">Dating</span>
        </a>
        <div class="flex items-center gap-6">
           
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-semibold">
                        {{ student_name }}
                    </div>
                    <span class="text-gray-800 font-medium">
                        {{ student_name }}
                    </span>
                </div>

                <a href="/logout"
                   class="text-sm text-red-500 hover:text-red-600 font-medium">
                    Déconnexion
                </a>
        
        </div>
    </div>
</header>

<main class="flex-1 max-w-7xl mx-auto px-6 py-8">
    {% block content %}
    {% endblock %}
</main>

<footer class="bg-gray-900 text-gray-300">
    <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm">
            © {{ "now"|date("Y") }} Job Dating — Tous droits réservés
        </p>
    </div>
</footer>

</body>
</html>